{
  "manifest_version": 3,
  "name": "TubeText — YouTube Transcripts & AI Summaries",
  "version": "0.1.0",
  "description": "Get the full transcript or an AI summary of any YouTube video without leaving the watch page. Powered by tubetext.app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://api.tubetext.app/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
